{
  "name": "webgl-model-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地三维模型查看器：TypeScript + WebGL2 读取 OBJ/MTL，检查结构并预览材质",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "generate:samples": "node scripts/generate-samples.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
