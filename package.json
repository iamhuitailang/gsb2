{
  "name": "local-rpa-console",
  "version": "1.0.0",
  "private": true,
  "description": "仅面向本地系统的 RPA 执行台：CSV 导入 + 本地模拟业务网站自动录入",
  "workspaces": [
    "server",
    "console"
  ],
  "scripts": {
    "install:browser": "playwright install chromium",
    "dev:server": "npm run dev --workspace server",
    "dev:console": "npm run dev --workspace console",
    "build:console": "npm run build --workspace console",
    "start": "npm run start --workspace server",
    "smoke": "node server/scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
