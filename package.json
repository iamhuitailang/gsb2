{
  "name": "mesh-paint-3d",
  "version": "1.0.0",
  "private": true,
  "description": "直接在三维模型表面绘制贴图的 WebGL 工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "e2e": "node scripts/e2e-check.mjs && node scripts/e2e-multi.mjs && node scripts/e2e-glb.mjs && node scripts/e2e-objects.mjs",
    "generate:samples": "node scripts/generate-samples.mjs && node scripts/generate-glb.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
