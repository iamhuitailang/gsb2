{
  "name": "normal-map-debug-bench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "浏览器内 WebGL 法线贴图调试台：普通 UV / 镜像 UV 对照、切线方向核查、绿通道约定切换",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "generate:samples": "node --experimental-strip-types scripts/generate-samples.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
