{
  "name": "third-person-camera-debugger",
  "version": "1.0.0",
  "private": true,
  "description": "第三人称游戏镜头调试器：镜头区域 / 跟随参数 / 遮挡避让 / 路线时间轴 / 配置导入导出",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsx scripts/logic-check.ts",
    "test:e2e": "node scripts/headless-check.mjs",
    "test:ui": "node scripts/ui-check.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "puppeteer-core": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
