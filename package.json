{
  "name": "camera-path-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Offline 3D camera-path editor with TypeScript and WebGL",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/build.mjs && node --test tests/",
    "generate:samples": "node scripts/build.mjs && node scripts/generate-samples.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
