{
  "name": "sprite-atlas-tool",
  "version": "1.0.0",
  "private": true,
  "description": "离线精灵图集整理工具（纯静态页面，无运行时依赖）",
  "scripts": {
    "generate:samples": "python3 tools/generate_samples.py",
