{
  "name": "curve-type-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Local-font TypeScript tool for setting text along open and closed curves.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
