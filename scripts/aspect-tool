#!/usr/bin/env python3
"""便捷入口: 自动把 src 加入 sys.path 后转发到 aspect_tool.cli。

可直接执行: ./scripts/aspect-tool diagnose input.mp4
也支持隔离模式: python3 -I scripts/aspect-tool probe input.mp4
(-I 会忽略 PYTHONPATH, 但本脚本用 sys.path 绝对路径注入, 不受影响)
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "src"))

from aspect_tool.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
