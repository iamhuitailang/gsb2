# 大而全的 .gitignore 模板
# repo_create.sh 建仓时拷贝为 repo/.gitignore; 新场景有额外运行期产物, 在「运行期产物」一节追加

# ---- 密钥与凭据(甲方红线: 不进仓库) ----
.env
.env.*
*.pem
*.key
*.token
credentials*
secret*
*.p12
*.pfx

# ---- 运行期产物 / 本地数据 ----
data.json
*.log
*.db
*.sqlite
*.sqlite3
tmp/

# ---- 依赖与构建产物 ----
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
target/
bin/
*.exe
*.test
*.out
coverage/
.coverage
.pytest_cache/

# ---- 系统与IDE ----
.DS_Store
.idea/
.vscode/
*.swp

# 样例素材由 tools/generate_samples.py 生成并已入库；
# 如需复现可运行 npm run generate:samples。这里只忽略运行期截图等临时产物
tmp_smoke_*.png
tmp/
