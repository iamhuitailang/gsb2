# 大而全的 .gitignore 模板
# repo_create.sh 建仓时拷贝为 repo/.gitignore; 新场景有额外运行期产物, 在「运行期产物」一节追加

# ---- 密钥与凭据(甲方红线: 不进仓库) ----
.env
.env.*
*.pem
*.key
*.token
credentials*
secret*
*.p12
*.pfx

# ---- 运行期产物 / 本地数据 ----
data.json
*.log
*.db
*.sqlite
*.sqlite3
tmp/

# ---- 依赖与构建产物 ----
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
target/
bin/
*.exe
*.test
*.out
coverage/
.coverage
.pytest_cache/

# ---- 系统与IDE ----
.DS_Store
.idea/
.vscode/
*.swp

# 生成的示例素材(可用 npm run generate:samples 恢复)
public/samples/

# ---- 视频防抖工具运行期产物 ----
# 注意: samples/*.mp4 是要求随附的示例素材, 不予忽略; 也可用 make_samples.py 再生成。
# 导出视频 / 参数 sidecar
exports/*
!exports/.gitkeep
# 保存的分析项目 JSON
projects/*
!projects/.gitkeep
# 临时视频校验输出
/tmp/

