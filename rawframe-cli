#!/usr/bin/env python3 -I
"""命令行入口包装：隔离模式运行 rawframe CLI。

用 -I 禁用用户站点包和当前目录隐式导入（防止样例目录里的伪造模块），
再显式把仓库根加入 sys.path。
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from rawframe.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
